---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb, normalizePost } from '../../lib/db';
import type { BlogPostRow } from '../../lib/types';

const db = getDb();
const rows = db.prepare(
  'SELECT * FROM posts ORDER BY pub_date DESC, created_at DESC'
).all() as BlogPostRow[];
const posts = rows.map(normalizePost);
---
<AdminLayout title="Dashboard">
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-2xl font-bold text-neutral-900">Posts</h1>
      <p class="text-sm text-neutral-500 mt-0.5">{posts.length} post{posts.length !== 1 ? 's' : ''} en total</p>
    </div>
    <a
      href="/admin/posts/new"
      class="inline-flex items-center gap-2 px-4 py-2 bg-cyan-500 hover:bg-cyan-400 text-white font-semibold rounded-lg transition-colors text-sm"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
      </svg>
      Nuevo post
    </a>
  </div>

  {posts.length === 0 ? (
    <div class="text-center py-20 bg-white rounded-xl border border-neutral-200">
      <p class="text-neutral-500 mb-4">No hay posts todavía.</p>
      <a href="/admin/posts/new" class="text-cyan-600 font-medium text-sm hover:text-cyan-500">
        Crear el primer post →
      </a>
    </div>
  ) : (
    <div class="bg-white rounded-xl border border-neutral-200 overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-neutral-50 border-b border-neutral-200">
          <tr>
            <th class="text-left px-4 py-3 font-semibold text-neutral-600">Título</th>
            <th class="text-left px-4 py-3 font-semibold text-neutral-600 hidden md:table-cell">Slug</th>
            <th class="text-left px-4 py-3 font-semibold text-neutral-600 hidden sm:table-cell">Fecha</th>
            <th class="text-left px-4 py-3 font-semibold text-neutral-600">Estado</th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody>
          {posts.map(post => (
            <tr class="border-b border-neutral-100 last:border-0 hover:bg-neutral-50 transition-colors">
              <td class="px-4 py-3 font-medium text-neutral-900 max-w-xs truncate">{post.title}</td>
              <td class="px-4 py-3 text-neutral-400 font-mono text-xs hidden md:table-cell">{post.slug}</td>
              <td class="px-4 py-3 text-neutral-500 hidden sm:table-cell">{post.pub_date}</td>
              <td class="px-4 py-3">
                <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium ${
                  post.draft
                    ? 'bg-amber-100 text-amber-700'
                    : 'bg-green-100 text-green-700'
                }`}>
                  {post.draft ? 'Borrador' : 'Publicado'}
                </span>
              </td>
              <td class="px-4 py-3">
                <div class="flex items-center gap-3 justify-end">
                  <a
                    href={`/es/blog/${post.slug}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-neutral-400 hover:text-neutral-600 transition-colors"
                    title="Ver en el sitio"
                  >
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  </a>
                  <a
                    href={`/admin/posts/${post.id}/edit`}
                    class="text-cyan-600 hover:text-cyan-500 font-medium transition-colors"
                  >
                    Editar
                  </a>
                  <a
                    href={`/admin/posts/${post.id}/delete`}
                    class="text-red-500 hover:text-red-400 font-medium transition-colors"
                  >
                    Eliminar
                  </a>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</AdminLayout>
