---
import { getLangFromUrl, getAlternateLang, getAlternatePath } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const alternateLang = getAlternateLang(lang);
const alternatePath = getAlternatePath(Astro.url.pathname, lang);
const t = useTranslations(lang);
---
<a
  href={alternatePath}
  class="px-3 py-1 rounded-md border border-neutral-300 dark:border-neutral-700 text-sm font-medium text-neutral-600 dark:text-neutral-400 hover:border-cyan-500 hover:text-cyan-500 dark:hover:border-cyan-400 dark:hover:text-cyan-400 transition-colors duration-200"
  lang={alternateLang}
  aria-label={t('lang.switch')}
>
  {alternateLang.toUpperCase()}
</a>
