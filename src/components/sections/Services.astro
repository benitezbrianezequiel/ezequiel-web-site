---
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/translations';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const services = [
  {
    titleKey: 'services.web',
    problemKey: 'services.web.problem',
    bullets: ['services.web.b1', 'services.web.b2', 'services.web.b3'],
    bgClass: 'bg-cyan-500/10 dark:bg-cyan-500/10',
    iconClass: 'text-cyan-500 dark:text-cyan-400',
    problemClass: 'text-cyan-600 dark:text-cyan-400',
    borderClass: 'border-l-4 border-l-cyan-500 dark:border-l-cyan-400',
    dotActive: 'bg-cyan-500',
  },
  {
    titleKey: 'services.mobile',
    problemKey: 'services.mobile.problem',
    bullets: ['services.mobile.b1', 'services.mobile.b2', 'services.mobile.b3'],
    bgClass: 'bg-violet-500/10 dark:bg-violet-500/10',
    iconClass: 'text-violet-500 dark:text-violet-400',
    problemClass: 'text-violet-600 dark:text-violet-400',
    borderClass: 'border-l-4 border-l-violet-500 dark:border-l-violet-400',
    dotActive: 'bg-violet-500',
  },
  {
    titleKey: 'services.backend',
    problemKey: 'services.backend.problem',
    bullets: ['services.backend.b1', 'services.backend.b2', 'services.backend.b3'],
    bgClass: 'bg-emerald-500/10 dark:bg-emerald-500/10',
    iconClass: 'text-emerald-500 dark:text-emerald-400',
    problemClass: 'text-emerald-600 dark:text-emerald-400',
    borderClass: 'border-l-4 border-l-emerald-500 dark:border-l-emerald-400',
    dotActive: 'bg-emerald-500',
  },
  {
    titleKey: 'services.automation',
    problemKey: 'services.automation.problem',
    bullets: ['services.automation.b1', 'services.automation.b2', 'services.automation.b3'],
    bgClass: 'bg-orange-500/10 dark:bg-orange-500/10',
    iconClass: 'text-orange-500 dark:text-orange-400',
    problemClass: 'text-orange-600 dark:text-orange-400',
    borderClass: 'border-l-4 border-l-orange-500 dark:border-l-orange-400',
    dotActive: 'bg-orange-500',
  },
];
---

<section id="services" class="section-padding bg-neutral-50 dark:bg-neutral-900">
  <div class="container mx-auto px-4 max-w-6xl">

    <!-- Header -->
    <div class="mb-14">
      <span class="text-sm font-semibold text-cyan-500 dark:text-cyan-400 uppercase tracking-widest">
        {t('services.title')}
      </span>
      <h2 class="section-title mt-2">{t('services.tagline')}</h2>
      <p class="text-neutral-500 dark:text-neutral-400 mt-3 text-lg max-w-xl">
        {t('services.subtitle')}
      </p>
      <div class="w-16 h-1 rounded-full bg-cyan-500 mt-5"></div>
    </div>

    <!-- Carousel -->
    <div class="relative" id="services-carousel">

      <!-- Track -->
      <div class="overflow-hidden">
        <div id="services-track" class="flex" style="transition: transform 0.45s cubic-bezier(0.4,0,0.2,1);">
          {services.map(({ titleKey, problemKey, bullets, bgClass, iconClass, problemClass, borderClass }, i) => (
            <div data-slide={i} class="min-w-full grid md:grid-cols-2 gap-0 md:gap-10 items-center">

              <!-- Illustration panel -->
              <div class={`relative rounded-2xl overflow-hidden flex items-center justify-center aspect-[4/3] ${bgClass} ${iconClass} mb-6 md:mb-0`}>
                {i === 0 && (
                  <!-- Web Development illustration: browser mockup -->
                  <svg viewBox="0 0 320 240" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-4/5 h-4/5" aria-hidden="true">
                    <!-- Browser frame -->
                    <rect x="10" y="10" width="300" height="220" rx="12" fill="currentColor" opacity="0.07" stroke="currentColor" stroke-width="1.5" opacity="0.3"/>
                    <!-- Chrome bar -->
                    <rect x="10" y="10" width="300" height="35" rx="12" fill="currentColor" opacity="0.15"/>
                    <rect x="10" y="33" width="300" height="12" fill="currentColor" opacity="0.15"/>
                    <!-- Traffic lights -->
                    <circle cx="30" cy="27" r="5" fill="currentColor" opacity="0.5"/>
                    <circle cx="44" cy="27" r="5" fill="currentColor" opacity="0.3"/>
                    <circle cx="58" cy="27" r="5" fill="currentColor" opacity="0.3"/>
                    <!-- URL bar -->
                    <rect x="82" y="18" width="156" height="18" rx="9" fill="currentColor" opacity="0.18"/>
                    <!-- Nav inside -->
                    <rect x="22" y="60" width="30" height="10" rx="5" fill="currentColor" opacity="0.4"/>
                    <rect x="196" y="62" width="24" height="6" rx="3" fill="currentColor" opacity="0.2"/>
                    <rect x="226" y="62" width="24" height="6" rx="3" fill="currentColor" opacity="0.2"/>
                    <rect x="260" y="58" width="40" height="14" rx="7" fill="currentColor" opacity="0.4"/>
                    <!-- Hero text -->
                    <rect x="22" y="84" width="130" height="16" rx="5" fill="currentColor" opacity="0.45"/>
                    <rect x="22" y="106" width="104" height="8" rx="3" fill="currentColor" opacity="0.2"/>
                    <rect x="22" y="120" width="118" height="8" rx="3" fill="currentColor" opacity="0.15"/>
                    <!-- CTA button -->
                    <rect x="22" y="138" width="76" height="22" rx="11" fill="currentColor" opacity="0.45"/>
                    <!-- Hero image placeholder -->
                    <rect x="176" y="80" width="120" height="92" rx="10" fill="currentColor" opacity="0.12" stroke="currentColor" stroke-width="1.5" opacity="0.25"/>
                    <path d="M206 124 L226 104 L248 124 M226 104 L246 134" stroke="currentColor" stroke-width="1.5" opacity="0.3" stroke-linecap="round"/>
                    <!-- Feature cards row -->
                    <rect x="22" y="176" width="84" height="42" rx="8" fill="currentColor" opacity="0.1" stroke="currentColor" stroke-width="1" opacity="0.18"/>
                    <rect x="118" y="176" width="84" height="42" rx="8" fill="currentColor" opacity="0.1" stroke="currentColor" stroke-width="1" opacity="0.18"/>
                    <rect x="214" y="176" width="82" height="42" rx="8" fill="currentColor" opacity="0.1" stroke="currentColor" stroke-width="1" opacity="0.18"/>
                    <rect x="30" y="186" width="38" height="5" rx="2.5" fill="currentColor" opacity="0.3"/>
                    <rect x="30" y="196" width="58" height="4" rx="2" fill="currentColor" opacity="0.18"/>
                    <rect x="30" y="205" width="50" height="4" rx="2" fill="currentColor" opacity="0.18"/>
                  </svg>
                )}

                {i === 1 && (
                  <!-- Mobile Apps illustration: phone mockup with floating cards -->
                  <svg viewBox="0 0 320 240" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-4/5 h-4/5" aria-hidden="true">
                    <!-- Phone frame -->
                    <rect x="110" y="8" width="100" height="198" rx="20" fill="currentColor" opacity="0.1" stroke="currentColor" stroke-width="2" opacity="0.45"/>
                    <!-- Screen -->
                    <rect x="116" y="26" width="88" height="166" rx="8" fill="currentColor" opacity="0.06"/>
                    <!-- Notch -->
                    <rect x="140" y="13" width="40" height="7" rx="3.5" fill="currentColor" opacity="0.4"/>
                    <!-- Home bar -->
                    <rect x="145" y="199" width="30" height="3" rx="1.5" fill="currentColor" opacity="0.35"/>
                    <!-- Status bar -->
                    <rect x="120" y="30" width="28" height="4" rx="2" fill="currentColor" opacity="0.25"/>
                    <circle cx="196" cy="32" r="3" fill="currentColor" opacity="0.3"/>
                    <!-- App header -->
                    <rect x="116" y="42" width="88" height="24" fill="currentColor" opacity="0.15"/>
                    <rect x="130" y="49" width="60" height="8" rx="3" fill="currentColor" opacity="0.45"/>
                    <!-- Content list items -->
                    <rect x="122" y="74" width="76" height="20" rx="5" fill="currentColor" opacity="0.12"/>
                    <circle cx="134" cy="84" r="6" fill="currentColor" opacity="0.3"/>
                    <rect x="145" y="80" width="40" height="5" rx="2.5" fill="currentColor" opacity="0.3"/>
                    <rect x="145" y="89" width="30" height="4" rx="2" fill="currentColor" opacity="0.18"/>
                    <rect x="122" y="100" width="76" height="20" rx="5" fill="currentColor" opacity="0.2"/>
                    <circle cx="134" cy="110" r="6" fill="currentColor" opacity="0.4"/>
                    <rect x="145" y="106" width="44" height="5" rx="2.5" fill="currentColor" opacity="0.4"/>
                    <rect x="145" y="115" width="32" height="4" rx="2" fill="currentColor" opacity="0.2"/>
                    <rect x="122" y="126" width="76" height="20" rx="5" fill="currentColor" opacity="0.12"/>
                    <circle cx="134" cy="136" r="6" fill="currentColor" opacity="0.3"/>
                    <rect x="145" y="132" width="36" height="5" rx="2.5" fill="currentColor" opacity="0.3"/>
                    <rect x="145" y="141" width="48" height="4" rx="2" fill="currentColor" opacity="0.18"/>
                    <!-- Bottom nav -->
                    <rect x="116" y="172" width="88" height="20" fill="currentColor" opacity="0.15"/>
                    <circle cx="143" cy="182" r="4" fill="currentColor" opacity="0.35"/>
                    <circle cx="160" cy="182" r="5" fill="currentColor" opacity="0.65"/>
                    <circle cx="177" cy="182" r="4" fill="currentColor" opacity="0.35"/>
                    <!-- Floating notification card (left) -->
                    <rect x="12" y="72" width="90" height="52" rx="10" fill="currentColor" opacity="0.08" stroke="currentColor" stroke-width="1.5" opacity="0.3"/>
                    <circle cx="27" cy="93" r="10" fill="currentColor" opacity="0.2"/>
                    <rect x="42" y="82" width="48" height="6" rx="3" fill="currentColor" opacity="0.35"/>
                    <rect x="42" y="93" width="38" height="4" rx="2" fill="currentColor" opacity="0.2"/>
                    <rect x="42" y="102" width="44" height="4" rx="2" fill="currentColor" opacity="0.2"/>
                    <!-- Floating rating card (right) -->
                    <rect x="218" y="112" width="90" height="44" rx="10" fill="currentColor" opacity="0.08" stroke="currentColor" stroke-width="1.5" opacity="0.3"/>
                    <rect x="228" y="122" width="50" height="6" rx="3" fill="currentColor" opacity="0.35"/>
                    <path d="M228 138 L232 130 L236 138 L228 133 L236 133 Z" fill="currentColor" opacity="0.5"/>
                    <path d="M238 138 L242 130 L246 138 L238 133 L246 133 Z" fill="currentColor" opacity="0.5"/>
                    <path d="M248 138 L252 130 L256 138 L248 133 L256 133 Z" fill="currentColor" opacity="0.5"/>
                    <path d="M258 138 L262 130 L266 138 L258 133 L266 133 Z" fill="currentColor" opacity="0.5"/>
                    <path d="M268 138 L272 130 L276 138 L268 133 L276 133 Z" fill="currentColor" opacity="0.25"/>
                  </svg>
                )}

                {i === 2 && (
                  <!-- Backend & APIs illustration: connected nodes diagram -->
                  <svg viewBox="0 0 320 240" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-4/5 h-4/5" aria-hidden="true">
                    <!-- Client box -->
                    <rect x="12" y="80" width="72" height="80" rx="10" fill="currentColor" opacity="0.1" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
                    <rect x="22" y="93" width="52" height="7" rx="3.5" fill="currentColor" opacity="0.4"/>
                    <rect x="22" y="106" width="42" height="5" rx="2.5" fill="currentColor" opacity="0.2"/>
                    <rect x="22" y="116" width="48" height="5" rx="2.5" fill="currentColor" opacity="0.2"/>
                    <rect x="22" y="126" width="36" height="5" rx="2.5" fill="currentColor" opacity="0.15"/>
                    <rect x="22" y="136" width="44" height="5" rx="2.5" fill="currentColor" opacity="0.15"/>
                    <!-- Client label -->
                    <rect x="25" y="84" width="30" height="6" rx="3" fill="currentColor" opacity="0.3"/>
                    <!-- API server (center) -->
                    <rect x="122" y="50" width="76" height="140" rx="12" fill="currentColor" opacity="0.14" stroke="currentColor" stroke-width="2" opacity="0.5"/>
                    <!-- LED indicators -->
                    <circle cx="138" cy="70" r="5" fill="currentColor" opacity="0.85"/>
                    <circle cx="152" cy="70" r="5" fill="currentColor" opacity="0.4"/>
                    <circle cx="166" cy="70" r="5" fill="currentColor" opacity="0.25"/>
                    <!-- Server rack lines -->
                    <rect x="133" y="86" width="54" height="5" rx="2.5" fill="currentColor" opacity="0.3"/>
                    <rect x="133" y="96" width="44" height="5" rx="2.5" fill="currentColor" opacity="0.2"/>
                    <rect x="133" y="106" width="50" height="5" rx="2.5" fill="currentColor" opacity="0.3"/>
                    <rect x="133" y="116" width="38" height="5" rx="2.5" fill="currentColor" opacity="0.2"/>
                    <rect x="133" y="126" width="52" height="5" rx="2.5" fill="currentColor" opacity="0.3"/>
                    <rect x="133" y="136" width="42" height="5" rx="2.5" fill="currentColor" opacity="0.2"/>
                    <rect x="133" y="146" width="46" height="5" rx="2.5" fill="currentColor" opacity="0.3"/>
                    <!-- API label chip -->
                    <rect x="134" y="60" width="52" height="8" rx="4" fill="currentColor" opacity="0.45"/>
                    <!-- Database cylinder (right) -->
                    <ellipse cx="268" cy="98" rx="30" ry="12" fill="currentColor" opacity="0.15" stroke="currentColor" stroke-width="1.5" opacity="0.45"/>
                    <rect x="238" y="98" width="60" height="56" fill="currentColor" opacity="0.08"/>
                    <rect x="238" y="98" width="60" height="56" stroke="currentColor" stroke-width="1.5" opacity="0.3"/>
                    <ellipse cx="268" cy="154" rx="30" ry="12" fill="currentColor" opacity="0.12" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
                    <!-- DB separator lines -->
                    <ellipse cx="268" cy="119" rx="30" ry="8" fill="none" stroke="currentColor" stroke-width="1" opacity="0.2"/>
                    <ellipse cx="268" cy="138" rx="30" ry="8" fill="none" stroke="currentColor" stroke-width="1" opacity="0.2"/>
                    <!-- DB label -->
                    <rect x="252" y="88" width="32" height="7" rx="3.5" fill="currentColor" opacity="0.3"/>
                    <!-- Arrow: client → API -->
                    <path d="M85 115 L118 107" stroke="currentColor" stroke-width="1.5" stroke-dasharray="5 3" opacity="0.55"/>
                    <path d="M112 103 L120 107 L114 112" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.55"/>
                    <!-- Arrow: API → DB -->
                    <path d="M200 115 L236 115" stroke="currentColor" stroke-width="1.5" stroke-dasharray="5 3" opacity="0.55"/>
                    <path d="M230 111 L238 115 L230 119" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity="0.55"/>
                    <!-- Label chips on arrows -->
                    <rect x="88" y="96" width="30" height="10" rx="5" fill="currentColor" opacity="0.25"/>
                    <rect x="202" y="103" width="30" height="10" rx="5" fill="currentColor" opacity="0.25"/>
                  </svg>
                )}

                {i === 3 && (
                  <!-- Automations illustration: process flow -->
                  <svg viewBox="0 0 320 240" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-4/5 h-4/5" aria-hidden="true">
                    <!-- Step 1: Input box -->
                    <rect x="10" y="78" width="72" height="84" rx="10" fill="currentColor" opacity="0.1" stroke="currentColor" stroke-width="1.5" opacity="0.4"/>
                    <rect x="20" y="91" width="52" height="7" rx="3.5" fill="currentColor" opacity="0.4"/>
                    <rect x="20" y="104" width="42" height="5" rx="2.5" fill="currentColor" opacity="0.2"/>
                    <rect x="20" y="114" width="50" height="5" rx="2.5" fill="currentColor" opacity="0.15"/>
                    <rect x="20" y="124" width="38" height="5" rx="2.5" fill="currentColor" opacity="0.2"/>
                    <rect x="20" y="134" width="46" height="5" rx="2.5" fill="currentColor" opacity="0.15"/>
                    <!-- Step 1 label chip -->
                    <rect x="14" y="152" width="64" height="8" rx="4" fill="currentColor" opacity="0.3"/>
                    <!-- Arrow 1 (dashed) -->
                    <path d="M84 118 L118 118" stroke="currentColor" stroke-width="2" stroke-dasharray="5 3" opacity="0.5"/>
                    <path d="M112 114 L120 118 L112 122" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"/>
                    <!-- Step 2: Gear / process (center) -->
                    <rect x="120" y="62" width="80" height="116" rx="12" fill="currentColor" opacity="0.18" stroke="currentColor" stroke-width="2" opacity="0.5"/>
                    <!-- Outer gear ring -->
                    <circle cx="160" cy="116" r="24" fill="none" stroke="currentColor" stroke-width="2" opacity="0.5"/>
                    <!-- Inner circle -->
                    <circle cx="160" cy="116" r="10" fill="currentColor" opacity="0.35"/>
                    <!-- Gear teeth -->
                    <rect x="155" y="84" width="10" height="10" rx="3" fill="currentColor" opacity="0.45"/>
                    <rect x="155" y="138" width="10" height="10" rx="3" fill="currentColor" opacity="0.45"/>
                    <rect x="126" y="110" width="10" height="12" rx="3" fill="currentColor" opacity="0.45"/>
                    <rect x="184" y="110" width="10" height="12" rx="3" fill="currentColor" opacity="0.45"/>
                    <rect x="134" y="91" width="9" height="9" rx="3" fill="currentColor" opacity="0.35"/>
                    <rect x="177" y="91" width="9" height="9" rx="3" fill="currentColor" opacity="0.35"/>
                    <rect x="134" y="136" width="9" height="9" rx="3" fill="currentColor" opacity="0.35"/>
                    <rect x="177" y="136" width="9" height="9" rx="3" fill="currentColor" opacity="0.35"/>
                    <!-- Process label -->
                    <rect x="130" y="168" width="60" height="8" rx="4" fill="currentColor" opacity="0.4"/>
                    <!-- Arrow 2 (dashed) -->
                    <path d="M202 118 L232 118" stroke="currentColor" stroke-width="2" stroke-dasharray="5 3" opacity="0.5"/>
                    <path d="M226 114 L234 118 L226 122" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.5"/>
                    <!-- Step 3: Output / checkmark -->
                    <rect x="234" y="78" width="76" height="84" rx="10" fill="currentColor" opacity="0.15" stroke="currentColor" stroke-width="1.5" opacity="0.45"/>
                    <circle cx="272" cy="118" r="22" fill="none" stroke="currentColor" stroke-width="2" opacity="0.5"/>
                    <path d="M260 118 L268 126 L284 108" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.75"/>
                    <!-- Step 3 label chip -->
                    <rect x="240" y="154" width="64" height="8" rx="4" fill="currentColor" opacity="0.35"/>
                    <!-- Results ribbon at bottom -->
                    <rect x="60" y="188" width="200" height="30" rx="15" fill="currentColor" opacity="0.1" stroke="currentColor" stroke-width="1.5" opacity="0.3"/>
                    <circle cx="82" cy="203" r="8" fill="currentColor" opacity="0.35"/>
                    <rect x="96" y="198" width="70" height="5" rx="2.5" fill="currentColor" opacity="0.35"/>
                    <rect x="96" y="207" width="50" height="4" rx="2" fill="currentColor" opacity="0.2"/>
                    <!-- Clock icon in ribbon -->
                    <circle cx="228" cy="203" r="8" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.45"/>
                    <path d="M228 197 L228 203 L234 203" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.55"/>
                    <rect x="240" y="199" width="16" height="4" rx="2" fill="currentColor" opacity="0.3"/>
                    <rect x="240" y="207" width="12" height="3.5" rx="1.75" fill="currentColor" opacity="0.2"/>
                  </svg>
                )}
              </div>

              <!-- Content panel -->
              <div class={`bg-white dark:bg-neutral-800/60 rounded-2xl ${borderClass} p-8`}>
                <h3 class="text-2xl font-bold text-neutral-900 dark:text-neutral-100 mb-3">
                  {t(titleKey)}
                </h3>
                <p class={`text-sm font-medium italic ${problemClass} mb-6 leading-relaxed border-l-2 border-current pl-3`}>
                  "{t(problemKey)}"
                </p>
                <ul class="space-y-3">
                  {bullets.map(key => (
                    <li class="flex items-start gap-3 text-sm text-neutral-600 dark:text-neutral-400">
                      <svg class={`w-4 h-4 ${iconClass} mt-0.5 flex-shrink-0`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                      </svg>
                      {t(key)}
                    </li>
                  ))}
                </ul>
              </div>

            </div>
          </div>
        ))}
      </div>

      <!-- Progress bar -->
      <div class="w-full h-0.5 bg-neutral-200 dark:bg-neutral-700 mt-8 rounded-full overflow-hidden">
        <div id="srv-progress-bar" class="h-full rounded-full" style="width:0%"></div>
      </div>

      <!-- Controls -->
      <div class="flex items-center justify-center gap-4 mt-5">
        <button
          id="srv-prev"
          aria-label="Anterior"
          class="w-10 h-10 rounded-full border border-neutral-300 dark:border-neutral-600 flex items-center justify-center text-neutral-500 dark:text-neutral-400 hover:border-cyan-500 hover:text-cyan-500 dark:hover:border-cyan-400 dark:hover:text-cyan-400 transition-colors"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>

        <div id="srv-dots" class="flex gap-2">
          {services.map((_, i) => (
            <button
              data-dot={i}
              aria-label={`Ir a slide ${i + 1}`}
              class="h-2 rounded-full transition-all duration-300 bg-neutral-300 dark:bg-neutral-600 w-2"
            />
          ))}
        </div>

        <button
          id="srv-next"
          aria-label="Siguiente"
          class="w-10 h-10 rounded-full border border-neutral-300 dark:border-neutral-600 flex items-center justify-center text-neutral-500 dark:text-neutral-400 hover:border-cyan-500 hover:text-cyan-500 dark:hover:border-cyan-400 dark:hover:text-cyan-400 transition-colors"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </button>
      </div>

    </div>
  </div>
</section>

<script is:inline>
  (function () {
    var INTERVAL = 5000;
    var track = document.getElementById('services-track');
    var bar = document.getElementById('srv-progress-bar');
    var dots = Array.from(document.querySelectorAll('#srv-dots [data-dot]'));
    var carousel = document.getElementById('services-carousel');
    var total = dots.length;
    var current = 0;
    var timer = null;
    var paused = false;

    var dotColors = ['bg-cyan-500', 'bg-violet-500', 'bg-emerald-500', 'bg-orange-500'];
    var barColors = ['#06b6d4', '#8b5cf6', '#10b981', '#f97316'];

    function restartProgress() {
      bar.style.transition = 'none';
      bar.style.width = '0%';
      bar.style.backgroundColor = barColors[current];
      // force reflow so the transition reset takes effect
      bar.offsetWidth;
      bar.style.transition = 'width ' + INTERVAL + 'ms linear';
      bar.style.width = '100%';
    }

    function goTo(n) {
      current = ((n % total) + total) % total;
      track.style.transform = 'translateX(-' + (current * 100) + '%)';
      dots.forEach(function (d, i) {
        d.className = 'h-2 rounded-full transition-all duration-300 ';
        if (i === current) {
          d.className += dotColors[i] + ' w-6';
        } else {
          d.className += 'bg-neutral-300 dark:bg-neutral-600 w-2';
        }
      });
      if (!paused) restartProgress();
    }

    function startTimer() {
      clearInterval(timer);
      timer = setInterval(function () { goTo(current + 1); }, INTERVAL);
      restartProgress();
    }

    function stopTimer() {
      clearInterval(timer);
      bar.style.transition = 'none';
      bar.style.width = bar.getBoundingClientRect().width
        ? (bar.getBoundingClientRect().width / bar.parentElement.getBoundingClientRect().width * 100) + '%'
        : '0%';
    }

    // Buttons & dots — reset timer on manual interaction
    document.getElementById('srv-prev').addEventListener('click', function () {
      goTo(current - 1);
      if (!paused) startTimer();
    });
    document.getElementById('srv-next').addEventListener('click', function () {
      goTo(current + 1);
      if (!paused) startTimer();
    });
    dots.forEach(function (d, i) {
      d.addEventListener('click', function () {
        goTo(i);
        if (!paused) startTimer();
      });
    });

    // Pause on hover
    carousel.addEventListener('mouseenter', function () {
      paused = true;
      stopTimer();
    });
    carousel.addEventListener('mouseleave', function () {
      paused = false;
      startTimer();
    });

    // Touch swipe
    var startX = 0;
    track.addEventListener('touchstart', function (e) {
      startX = e.touches[0].clientX;
      paused = true;
      stopTimer();
    }, { passive: true });
    track.addEventListener('touchend', function (e) {
      var diff = startX - e.changedTouches[0].clientX;
      if (Math.abs(diff) > 40) goTo(diff > 0 ? current + 1 : current - 1);
      paused = false;
      startTimer();
    }, { passive: true });

    // Start only when the section enters the viewport
    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting && !paused) {
            startTimer();
          } else {
            clearInterval(timer);
          }
        });
      }, { threshold: 0.3 });
      observer.observe(carousel);
    } else {
      startTimer();
    }

    goTo(0);
  })();
</script>
